# URL base del backend PHP (Laravel / Slim / API REST propia)
VITE_API_BASE_URL=http://localhost:8000/api

# true  -> usa los datos simulados de src/simulados
# false -> consume la API REST real definida en VITE_API_BASE_URL
VITE_USE_MOCK_DATA=true

# Si el backend usa Laravel Sanctum con cookies (SPA auth), poner en true
VITE_API_WITH_CREDENTIALS=false
